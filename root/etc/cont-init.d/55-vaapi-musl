#!/usr/bin/with-contenv bash
#
# Replace Plex's bundled musl 1.2.2 with the newer musl shipped in /vaapi-amdgpu.
#
# Plex's musl 1.2.2 cannot load this Mesa. First it cannot resolve qsort_r
# (musl >= 1.2.3), and once that is supplied it segfaults in the driver's
# constructors at an indirect call. The identical binaries, driver and GPU work
# under musl 1.2.5 - verified with a real h264_vaapi encode.
#
# This has to cover Plex Media Server, not just the transcoder. PMS links
# libavcodec/libavutil/libdrm directly and probes VAAPI *in process* to decide
# whether hardware transcoding is available. If that probe fails, PMS logs
# "hardware transcoding: enabled, but no hardware decode accelerator found" and
# uses the CPU for everything - no matter what the transcoder alone could do.
# Replacing the bundled libc covers every Plex binary at once, which is why this
# is done instead of wrapping individual executables.
#
# musl is forward-compatible, so running Plex's 1.2.2-linked binaries on 1.2.5
# is the safe direction. The build gates check that every Plex binary still
# relocates cleanly under the loader shipped here.
#
# This runs at every container start rather than at build time because the image
# is FROM plexinc/pms-docker:public, which reinstalls Plex over
# /usr/lib/plexmediaserver on every start (50-plex-update, which runs just
# before this) and restores the 1.2.2 files.
#
# Fails soft, always. A server that transcodes on the CPU is a working server;
# one that will not start is not. Every bail-out below exits 0.

PMS=/usr/lib/plexmediaserver
PLEXLIB="$PMS/lib"
NEW=/vaapi-amdgpu/lib/ld-musl-x86_64.so.1

log() { echo "[vaapi] $*"; }

if [ ! -x "$NEW" ]; then
	log "no bundled musl at $NEW - leaving Plex alone"
	exit 0
fi

if [ ! -d "$PLEXLIB" ]; then
	log "no $PLEXLIB - leaving Plex alone"
	exit 0
fi

# Undo the earlier wrapper approach if a container somehow still carries it.
if [ -e "$PMS/Plex Transcoder.real" ]; then
	mv -f "$PMS/Plex Transcoder.real" "$PMS/Plex Transcoder" 2>/dev/null &&
		log "removed the obsolete transcoder wrapper"
fi

# In musl the loader and libc are the same file, and Plex ships it under both
# names. Both are replaced: the binaries reference libc.so through their
# RUNPATH, and ld-musl-x86_64.so.1 is what anything invoking the loader by name
# picks up.
replaced=0
for name in ld-musl-x86_64.so.1 libc.so; do
	target="$PLEXLIB/$name"
	[ -e "$target" ] || continue
	if cmp -s "$NEW" "$target"; then
		continue
	fi
	if cp -f "$NEW" "$target"; then
		replaced=$((replaced + 1))
	else
		log "WARNING: could not replace $target - hardware transcoding will not work"
	fi
done

if [ "$replaced" -eq 0 ]; then
	log "Plex already using the bundled musl"
else
	log "replaced Plex's musl with $("$NEW" 2>&1 | sed -n 's/^Version /musl /p') ($replaced file(s))"
fi

# Keep Mesa's shader cache writable by the plex user.
#
# Mesa caches compiled shaders under $HOME/.cache, and Plex's HOME is /config.
# Anything that runs the transcoder by hand inside the container - the
# verification command in README.md, for instance - runs as root and creates
# that directory root-owned and mode 0700. PMS runs as plex and then cannot use
# it, so Mesa logs
#
#   Failed to create /config/.cache/mesa_shader_cache for shader cache
#   (Permission denied)---disabling.
#
# and recompiles its shaders in every transcoder process instead. Harmless -
# VAAPI encode/decode is fixed-function, and shaders only cover colour
# conversion, scaling and blits - but it is pure waste and a confusing error.
#
# pms-docker's own CHANGE_CONFIG_DIR_OWNERSHIP repair does not catch this: it
# only runs when Preferences.xml itself is not plex-owned.
plexhome=$(getent passwd plex 2>/dev/null | cut -d: -f6)
cachedir="${plexhome:-/config}/.cache"
if [ -d "$cachedir" ] && [ "$(stat -c %u "$cachedir" 2>/dev/null)" != "$(id -u plex 2>/dev/null)" ]; then
	if chown -R plex:plex "$cachedir" 2>/dev/null; then
		log "repaired ownership of $cachedir (shader cache was unwritable)"
	else
		log "WARNING: $cachedir is not writable by plex; Mesa will recompile shaders each run"
	fi
fi

# Point Plex's libdrm_amdgpu at an amdgpu.ids it can actually find.
#
# Plex's bundled libdrm_amdgpu.so.1 has the path to amdgpu.ids baked in as its
# build machine's conan directory, which of course does not exist here:
#
#   /home/runner/_work/plex-conan/.../meson-install/share/libdrm/amdgpu.ids:
#   No such file or directory
#
# Plex's copy wins over the payload's because Plex's own RUNPATH resolves
# libdrm_amdgpu.so.1 first, and once a soname is loaded musl reuses it - so the
# copy at /usr/share/libdrm/amdgpu.ids is never consulted.
#
# The file only maps PCI id + revision to a marketing name, so the cost of it
# missing is cosmetic. Symlinking it is free and removes seven lines of noise
# from every startup. The path is read out of the binary rather than hardcoded,
# so it keeps working when Plex bumps its bundled libdrm.
IDS=/vaapi-amdgpu/share/libdrm/amdgpu.ids
if [ -e "$IDS" ] && [ -e "$PLEXLIB/libdrm_amdgpu.so.1" ]; then
	want=$(tr -c '[:print:]' '\n' < "$PLEXLIB/libdrm_amdgpu.so.1" 2>/dev/null |
		grep -m1 '/share/libdrm/amdgpu\.ids$')
	case "$want" in
	/*)
		if [ ! -e "$want" ] && mkdir -p "$(dirname "$want")" 2>/dev/null &&
			ln -sf "$IDS" "$want" 2>/dev/null; then
			log "linked amdgpu.ids into the path Plex's libdrm expects"
		fi
		;;
	esac
fi
