#!/usr/bin/with-contenv bash
#
# Make "Plex Transcoder" run under the musl loader bundled in /vaapi-amdgpu.
#
# Plex bundles musl 1.2.2, and that loader cannot correctly dlopen Mesa: libva
# finds the driver, then the process dies with SIGSEGV at an indirect call
# (ip 0x2100) during the driver's constructors. The identical binary, driver and
# GPU work under musl 1.2.5 - verified with a real h264_vaapi encode. So the fix
# is to launch the transcoder with the newer loader.
#
# This runs at every container start rather than at build time because the image
# is FROM plexinc/pms-docker:public, which installs a fresh Plex over
# /usr/lib/plexmediaserver on every start (50-plex-update, which runs just
# before this). Anything patched into that directory at build time is discarded.
#
# Only the transcoder is wrapped, not Plex Media Server itself: it is the only
# process that loads the VA driver, so this keeps the blast radius as small as
# it can be.
#
# Fails soft, always. A server that transcodes on the CPU is a working server;
# one that will not start is not. Every bail-out below exits 0.

PMS=/usr/lib/plexmediaserver
TRANSCODER="$PMS/Plex Transcoder"
REAL="$PMS/Plex Transcoder.real"
LOADER=/vaapi-amdgpu/lib/ld-musl-x86_64.so.1

log() { echo "[vaapi] $*"; }

if [ ! -x "$LOADER" ]; then
	log "no bundled musl loader at $LOADER - leaving the transcoder alone"
	exit 0
fi

if [ ! -e "$TRANSCODER" ]; then
	log "no transcoder at $TRANSCODER - leaving it alone"
	exit 0
fi

# A wrapped transcoder starts with a shebang; the real one is an ELF.
if [ "$(head -c 2 "$TRANSCODER" 2>/dev/null)" = '#!' ]; then
	if [ -e "$REAL" ]; then
		log "already wrapped"
		exit 0
	fi
	# Wrapper present but the real binary is gone. Nothing here can fix that;
	# say so loudly rather than pretending hardware transcoding works.
	log "ERROR: $TRANSCODER is a wrapper but $REAL is missing."
	log "ERROR: delete both and restart to let Plex reinstall the transcoder."
	exit 0
fi

if ! mv -f "$TRANSCODER" "$REAL"; then
	log "could not move the transcoder aside - leaving it alone"
	exit 0
fi

# --library-path is searched before DT_RPATH by musl, so Plex's own lib
# directory is listed first: its libraries must keep winning over the Alpine
# ones in the payload. The payload comes second, for Mesa's dependencies.
cat > "$TRANSCODER" <<EOF
#!/bin/sh
# Generated by /etc/cont-init.d/55-vaapi-transcoder. Do not edit.
exec "$LOADER" --library-path "$PMS/lib:/vaapi-amdgpu/lib" "$REAL" "\$@"
EOF

chmod 0755 "$TRANSCODER"
log "transcoder wrapped to run under $(basename "$LOADER") from the payload"
